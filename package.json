{
  "name": "filipe-carneiro-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "linkedin:import": "node scripts/linkedin-import.mjs",
    "test": "vitest run",
    "check:privacy": "node scripts/check-sensitive.mjs",
    "check": "npm run check:privacy && npm test && npm run build && node scripts/check-sensitive.mjs && npm run test:e2e",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null && chmod +x .githooks/pre-commit 2>/dev/null || true",
    "check:history": "node scripts/check-sensitive.mjs --history",
    "test:e2e": "node scripts/e2e.mjs",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "axe-core": "^4.10.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "playwright": "^1.63.0",
    "typescript": "^5.9.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
